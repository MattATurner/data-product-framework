# dpf: dataset=raw implements=select-engine-and-storage
resource "google_bigquery_dataset" "raw" {
  project                    = var.project_id
  dataset_id                 = "raw_example_files"
  location                   = var.region
  description                = "customer_orders: append-only raw landing, one table per source entity (generated by dpf)."
  delete_contents_on_destroy = false
  labels = {
    dpf_product = "customer_orders"
    dpf_layer   = "raw"
  }
}

