config {
  type: "view",
  schema: dataform.projectConfig.vars.staging_dataset,
  description: "Latest stg_orders rows that failed a quarantine rule, with _reject_reason.",
  tags: ["daily"]
}

-- dpf: model=stg_orders layer=staging role=staging skill=transform-raw-to-staging satisfies=R-7 part=rejects
SELECT * EXCEPT (_dpf_row_rank, _dpf_version_rank)
FROM ${ref("stg_orders__candidates")}
WHERE _dpf_row_rank = 1 AND _reject_reason IS NOT NULL
