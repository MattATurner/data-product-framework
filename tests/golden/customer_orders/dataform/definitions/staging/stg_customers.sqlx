config {
  type: "view",
  schema: dataform.projectConfig.vars.staging_dataset,
  description: "One row per customer with current details. Rows failing a quarantine rule are excluded.",
  tags: ["daily"]
}

-- dpf: model=stg_customers layer=staging role=staging skill=transform-raw-to-staging satisfies=R-1,R-5
SELECT * EXCEPT (_dpf_row_rank, _dpf_version_rank, _reject_reason)
FROM ${ref("stg_customers__candidates")}
WHERE _dpf_row_rank = 1 AND _reject_reason IS NULL
