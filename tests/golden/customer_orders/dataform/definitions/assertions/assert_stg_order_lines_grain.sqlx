config {
  type: "assertion",
  description: "stg_order_lines: one row per line on a customer order at its latest state — no duplicates on (order_id, order_line_no)",
  tags: ["daily"]
}

-- dpf: test=grain:stg_order_lines model=stg_order_lines satisfies=R-2,R-7
SELECT order_id, order_line_no, COUNT(*) AS rows_per_grain
FROM ${ref("stg_order_lines")}
GROUP BY order_id, order_line_no
HAVING COUNT(*) > 1
