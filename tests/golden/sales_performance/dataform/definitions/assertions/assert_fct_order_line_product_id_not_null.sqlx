config {
  type: "assertion",
  description: "fct_order_line: every line names a product_id (reference to dim_product)",
  tags: ["hourly", "monthly"]
}

-- dpf: test=integrity:fct_order_line:product_id:not_null model=fct_order_line satisfies=R-2,R-3,R-7,R-8,R-9
SELECT order_id, order_line_no
FROM ${ref("fct_order_line")}
WHERE product_id IS NULL
