config {
  type: "assertion",
  description: "fct_order_line: lines whose customer_id has not yet arrived in dim_customer (kept with the unknown member)",
  tags: ["hourly", "monthly"]
}

-- dpf: test=integrity:fct_order_line:dim_customer:late_arrival model=fct_order_line satisfies=R-2,R-3,R-7,R-8,R-9 severity=warn
SELECT order_id, order_line_no, customer_id
FROM ${ref("fct_order_line")}
WHERE sk_customer = -1
