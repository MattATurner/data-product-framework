config {
  type: "assertion",
  description: "dim_date: one row per calendar day — no duplicates on (date_key)",
  tags: ["hourly", "monthly"]
}

-- dpf: test=grain:dim_date model=dim_date satisfies=R-1
SELECT date_key, COUNT(*) AS rows_per_grain
FROM ${ref("dim_date")}
GROUP BY date_key
HAVING COUNT(*) > 1
