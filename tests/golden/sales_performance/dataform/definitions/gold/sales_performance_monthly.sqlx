config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "One row per month per customer segment per product category per region.",
  tags: ["hourly"],
  dependencies: ["assert_dim_customer_grain", "assert_dim_customer_grain_not_null", "assert_dim_customer_scd_no_overlap", "assert_dim_customer_scd_one_current", "assert_dim_date_grain", "assert_dim_date_grain_not_null", "assert_dim_product_grain", "assert_dim_product_grain_not_null", "assert_dim_product_scd_no_overlap", "assert_dim_product_scd_one_current", "assert_fct_order_line_customer_id_not_null", "assert_fct_order_line_grain", "assert_fct_order_line_grain_not_null", "assert_fct_order_line_product_id_not_null", "assert_stg_customers_grain", "assert_stg_customers_grain_not_null", "assert_stg_order_lines_grain", "assert_stg_order_lines_grain_not_null", "assert_stg_order_lines_no_rejects", "assert_stg_products_grain", "assert_stg_products_grain_not_null"]
}

-- dpf: model=sales_performance_monthly layer=gold role=business_view skill=direct/model-business-view satisfies=R-1,R-4,R-7,R-8
SELECT
  d.year_month,
  c.customer_segment,
  p.product_category,
  c.region,
  SUM(f.net_amount) AS net_sales,
  SUM(f.quantity)   AS units_sold,
  COUNT(*)          AS order_line_count
FROM ${ref("fct_order_line")} AS f
JOIN ${ref("dim_date")}     AS d ON d.date_key = f.date_key
JOIN ${ref("dim_customer")} AS c ON c.sk_customer = f.sk_customer
JOIN ${ref("dim_product")}  AS p ON p.sk_product = f.sk_product
WHERE NOT f.is_cancelled
GROUP BY d.year_month, c.customer_segment, p.product_category, c.region
