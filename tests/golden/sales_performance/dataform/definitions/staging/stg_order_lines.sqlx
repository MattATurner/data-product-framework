config {
  type: "view",
  schema: dataform.projectConfig.vars.staging_dataset,
  description: "One row per order line at its latest amended values. Rows failing a quarantine rule are excluded.",
  tags: ["hourly", "monthly"]
}

-- dpf: model=stg_order_lines layer=staging role=staging skill=transform-raw-to-staging satisfies=R-3,R-11 implements=conform-staging
SELECT * EXCEPT (_dpf_row_rank, _dpf_version_rank, _reject_reason)
FROM ${ref("stg_order_lines__candidates")}
WHERE _dpf_row_rank = 1 AND _reject_reason IS NULL
