# dpf: dataset=raw implements=select-engine-and-storage
resource "google_bigquery_dataset" "raw" {
  project                    = var.project_id
  dataset_id                 = "raw_ora_local"
  location                   = var.region
  description                = "sales_performance: append-only raw landing, one table per source entity (generated by dpf)."
  delete_contents_on_destroy = false
  labels = {
    dpf_product = "sales_performance"
    dpf_layer   = "raw"
  }
}

