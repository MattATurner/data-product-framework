{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/catalog-registration.v1.json",
  "title": "Catalog registration",
  "description": "What must exist in Knowledge Catalog before a product can be published.",
  "type": "object",
  "required": [
    "entry_ref",
    "aspects",
    "steward",
    "brd_link",
    "tdd_link",
    "semantics_link",
    "registered_via"
  ],
  "properties": {
    "entry_ref": {
      "type": "string"
    },
    "aspects": {
      "type": "object",
      "description": "Required aspect values keyed by aspect name.",
      "required": [
        "owner",
        "domain",
        "classification",
        "service_levels",
        "grain",
        "refresh_cadence",
        "status",
        "assumptions"
      ],
      "additionalProperties": true,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "service_levels": {
          "type": "object"
        },
        "grain": {
          "type": "object"
        },
        "refresh_cadence": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "glossary_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steward": {
      "type": "string"
    },
    "lineage_edges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_scan_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "brd_link": {
      "type": "string"
    },
    "tdd_link": {
      "type": "string"
    },
    "semantics_link": {
      "type": "string"
    },
    "registered_via": {
      "type": "string",
      "enum": [
        "knowledge-catalog-mcp",
        "dataplex_api",
        "terraform"
      ],
      "description": "Tier 1 MCP preferred - see registry/mcp_servers.yaml. CLI/API identifiers keep legacy strings."
    },
    "brd_requirement_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
    }
  },
  "additionalProperties": false
}
