{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/data-product.v1.json",
  "title": "Data product",
  "description": "The unit of delivery, assembled from the manifest. Versioned, owned, and accepted by the business.",
  "type": "object",
  "required": [
    "product_id",
    "version",
    "brd_id",
    "status",
    "owner",
    "domain",
    "output_ports",
    "classification",
    "semantics_signed"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "version": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/semver"
    },
    "brd_id": {
      "type": "string"
    },
    "tdd_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantics_signed": {
      "type": "boolean",
      "description": "True only when signoff.yaml matches the current semantic digest."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "provisional",
        "published",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "output_ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "https://dpf.dev/contracts/data-product.v1.json#/$defs/port_type"
          },
          "model": {
            "type": "string"
          },
          "access": {
            "type": "string"
          },
          "grain_statement": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brd_requirement_id": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
          }
        }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        }
      }
    },
    "classification": {
      "type": "string"
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Live BRD assumptions. Non-empty forces status=provisional."
    },
    "deprecation_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "brd_requirement_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "port_type": {
      "type": "string",
      "enum": [
        "bigquery_view",
        "bigquery_table",
        "materialized_view",
        "bigquery_sharing_listing",
        "iceberg_table",
        "extract_file"
      ]
    }
  }
}
