{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/brd.v1.json",
  "title": "Business requirements (structured answers)",
  "description": "The business-answerable rubric for one data product, groups A to K. Requirement statements and acceptance scenarios live in the BRD spec.md; this file holds the structured answers the design is derived from. No modelling vocabulary.",
  "type": "object",
  "required": [
    "brd_id",
    "product_id",
    "status",
    "version",
    "business_owner",
    "domain",
    "business_questions",
    "required_outputs",
    "level_of_detail",
    "history_behaviour",
    "timeliness",
    "exceptions",
    "fitness",
    "sources_believed",
    "sensitivity",
    "non_goals",
    "open_questions"
  ],
  "properties": {
    "brd_id": {
      "type": "string",
      "pattern": "^BRD-[A-Z0-9]+-\\d{3}$"
    },
    "product_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "version": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/semver"
    },
    "business_owner": {
      "type": "string"
    },
    "data_steward": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string",
      "description": "Group I. Business classification label."
    },
    "residency": {
      "type": "string",
      "description": "Where the data may be held, in business terms (a country or jurisdiction)."
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "change"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/semver"
          },
          "change": {
            "type": "string"
          },
          "raised_by": {
            "type": "string"
          },
          "accepted_by": {
            "type": "string"
          }
        }
      }
    },
    "business_questions": {
      "type": "array",
      "minItems": 1,
      "description": "Group A.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "decision_supported",
          "consumers"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BQ-\\d+$"
          },
          "text": {
            "type": "string"
          },
          "decision_supported": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "description": "Group B.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OUT-\\d+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "dashboard",
              "report",
              "extract",
              "api",
              "dataset"
            ]
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipient": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "satisfies": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
          }
        }
      }
    },
    "level_of_detail": {
      "type": "object",
      "description": "Group C.",
      "required": [
        "drill_to",
        "distinct_by"
      ],
      "additionalProperties": false,
      "properties": {
        "drill_to": {
          "type": "string"
        },
        "distinct_by": {
          "type": "string"
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "history_behaviour": {
      "type": "array",
      "description": "Group D. May be empty only when nothing can change.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "attribute",
          "question",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HB-\\d+$"
          },
          "attribute": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "satisfies": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
          }
        }
      }
    },
    "agreement_with_other_teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "team",
          "must_agree_on"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AG-\\d+$"
          },
          "team": {
            "type": "string"
          },
          "must_agree_on": {
            "type": "string"
          },
          "satisfies": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
          }
        }
      }
    },
    "totalling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_be_summed_across": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "timeliness": {
      "type": "object",
      "description": "Group E.",
      "required": [
        "freshness_need",
        "justification"
      ],
      "additionalProperties": false,
      "properties": {
        "freshness_need": {
          "type": "string"
        },
        "justification": {
          "type": "string",
          "minLength": 10
        },
        "expected_users": {
          "type": "string"
        },
        "peak_volume": {
          "type": "string"
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "description": "Group F.",
      "items": {
        "type": "string"
      }
    },
    "fitness": {
      "type": "object",
      "description": "Group G.",
      "required": [
        "unusable_row",
        "on_bad_data"
      ],
      "additionalProperties": false,
      "properties": {
        "unusable_row": {
          "type": "string"
        },
        "on_bad_data": {
          "type": "string"
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "sources_believed": {
      "type": "array",
      "minItems": 1,
      "description": "Group H.",
      "items": {
        "type": "object",
        "required": [
          "system",
          "holds"
        ],
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string"
          },
          "holds": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          }
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restricted_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible_to_analysts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "who_may_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "external_readers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "who": {
          "type": "string"
        },
        "access": {
          "type": "string"
        },
        "satisfies": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "description": "Group K.",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "assumption": {
            "type": "string"
          },
          "blast_radius": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
