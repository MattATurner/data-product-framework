{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/quality-policy.v1.json",
  "title": "Quality policy",
  "description": "Rules derived from the BRD's fitness answers, plus the grain rule every model carries. Blocking rules are bound to the publication gate.",
  "type": "object",
  "required": [
    "product_id",
    "rules",
    "gate_behaviour"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://dpf.dev/contracts/quality-policy.v1.json#/$defs/rule"
      }
    },
    "gate_behaviour": {
      "type": "string",
      "enum": [
        "block",
        "warn"
      ]
    },
    "scan_schedule": {
      "type": [
        "string",
        "null"
      ]
    },
    "brd_requirement_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "model",
        "type",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(QR|GR)-[A-Za-z0-9_-]+$"
        },
        "model": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "not_null",
            "unique",
            "range",
            "set_membership",
            "referential",
            "freshness",
            "row_count",
            "custom_sql"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "block",
            "warn"
          ]
        },
        "on_fail": {
          "type": "string",
          "enum": [
            "fail",
            "quarantine"
          ],
          "description": "quarantine: route failing rows to the reject relation and block publication while any exist."
        },
        "brd_requirement_id": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
        },
        "implements": {
          "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/platform_capability"
        }
      }
    }
  }
}
