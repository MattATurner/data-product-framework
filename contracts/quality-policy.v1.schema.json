{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/quality-policy.v1.json",
  "title": "Quality policy",
  "description": "Rules derived from the BRD's fitness answers.",
  "type": "object",
  "required": [
    "rules",
    "gate_behaviour"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "not_null",
              "unique",
              "range",
              "set_membership",
              "referential",
              "freshness",
              "row_count",
              "custom_sql"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          },
          "expression": {
            "type": [
              "string",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn"
            ]
          },
          "brd_requirement_id": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gate_behaviour": {
      "type": "string",
      "enum": [
        "block",
        "warn"
      ]
    },
    "scan_schedule": {
      "type": [
        "string",
        "null"
      ]
    },
    "brd_requirement_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "BRD requirement IDs this artefact satisfies. Empty = orphan design, fails G1."
    }
  },
  "additionalProperties": false
}
