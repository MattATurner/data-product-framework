{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/test-spec.v1.json",
  "title": "Test specification",
  "description": "Every check a product must pass, generated by dpf from the declared grain, the quality policy, the pack's integrity rules and the acceptance mapping. Engine adapters render automated cases to assertions/tests.",
  "type": "object",
  "required": [
    "product_id",
    "artefact_digest",
    "cases"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "artefact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "method",
          "severity",
          "description",
          "satisfies"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "grain",
              "quality",
              "reject_gate",
              "scd_integrity",
              "integrity",
              "acceptance",
              "consistency",
              "static"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "automated",
              "static",
              "attestation"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn"
            ]
          },
          "description": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "sql": {
            "type": "string",
            "description": "Engine-neutral SQL; returns rows only on failure."
          },
          "check": {
            "type": "string"
          },
          "element": {
            "type": "string"
          },
          "attested_by_role": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verifies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AX-\\d+$"
            }
          },
          "satisfies": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
          },
          "implements": {
            "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/platform_capability"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
