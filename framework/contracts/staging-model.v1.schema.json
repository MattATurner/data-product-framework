{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/staging-model.v1.json",
  "title": "Staging model",
  "description": "Typed, deduplicated, conformed-to-house-standards. Methodology-neutral. Rows failing the BRD fitness definition are quarantined to the reject relation with a reason, never dropped.",
  "type": "object",
  "required": [
    "table_ref",
    "natural_key",
    "dedupe_strategy",
    "engine",
    "reject_table_ref",
    "grain_columns"
  ],
  "properties": {
    "table_ref": {
      "type": "string"
    },
    "engine": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/engine"
    },
    "natural_key": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "grain_columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dedupe_strategy": {
      "type": "string"
    },
    "type_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reject_table_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reject_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gate": {
      "type": "string",
      "enum": [
        "block",
        "warn"
      ]
    },
    "brd_requirement_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
    }
  },
  "additionalProperties": false
}
