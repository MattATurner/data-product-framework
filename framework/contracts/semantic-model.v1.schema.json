{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/semantic-model.v1.json",
  "title": "Semantic model",
  "description": "A modelled table or view. Methodology-neutral core; pack-specific detail in attributes. Packs emit this; engine adapters render it. Generated by dpf from the product manifest.",
  "type": "object",
  "required": [
    "model_ref",
    "methodology",
    "role",
    "grain_statement",
    "grain_columns",
    "grain_checksum",
    "engine",
    "storage_format",
    "materialisation",
    "history_semantics",
    "inputs"
  ],
  "properties": {
    "model_ref": {
      "type": "string"
    },
    "layer": {
      "type": "string",
      "enum": [
        "staging",
        "silver",
        "gold"
      ]
    },
    "methodology": {
      "type": "string",
      "description": "Pack id, or 'platform' for staging."
    },
    "role": {
      "type": "string",
      "description": "Legal roles are supplied by the active pack's methodology.yaml."
    },
    "grain_statement": {
      "type": "string",
      "minLength": 10
    },
    "grain_columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "grain_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash of the grain declaration. Must equal the TDD's declared grain."
    },
    "natural_key": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surrogate_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "history_semantics": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/history_semantics"
    },
    "engine": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/engine"
    },
    "storage_format": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/storage_format"
    },
    "materialisation": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/materialisation"
    },
    "dataset": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Upstream model or raw relation names."
    },
    "partition_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "cluster_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "brd_requirement_id": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/requirement_ids"
    },
    "implements": {
      "$ref": "https://dpf.dev/contracts/common.v1.json#/$defs/platform_capability"
    }
  },
  "additionalProperties": false
}
