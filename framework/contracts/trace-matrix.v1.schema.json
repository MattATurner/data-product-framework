{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpf.dev/contracts/trace-matrix.v1.json",
  "title": "Traceability matrix",
  "description": "Requirement -> decision -> design element -> artefact -> test -> evidence, generated by dpf trace. At G4 it is the acceptance pack.",
  "type": "object",
  "required": [
    "product_id",
    "brd",
    "rows"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "brd": {
      "type": "string"
    },
    "artefact_digest": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "decisions",
          "elements",
          "artefacts",
          "tests",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "requirement": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artefacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "missing",
                  "stale"
                ]
              },
              "last_passed": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
