        <mxCell id="node_DPF-04-02" value="&lt;b&gt;DPF-04-02  Bounded Dataform SQL Agent [◆] [AGENT]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Assists messy source SQL wrangling inside deterministic GEMINI.md guardrails.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="386" width="376" height="72" as="geometry"/></mxCell>
