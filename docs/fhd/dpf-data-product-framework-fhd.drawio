        <mxCell id="node_DPF-05-04" value="&lt;b&gt;DPF-05-04  Domain Attestation Gate [◆] [UI / HITL]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Records Finance and domain expert sign-offs on non-SQL business truths at Gate G4.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1790" y="562" width="376" height="72" as="geometry"/></mxCell>
