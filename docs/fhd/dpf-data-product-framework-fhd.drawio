        <mxCell id="node_DPF-04-01" value="&lt;b&gt;DPF-04-01  Gate G2 Pipeline Composer [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Selects stage skills and type-checks contract handoffs and engine support across the DAG.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="298" width="376" height="72" as="geometry"/></mxCell>
