        <mxCell id="node_DPF-02-02" value="&lt;b&gt;DPF-02-02  Gate G0 Rubric Validator [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Verifies groups A-K completeness, glossary alignment, and zero technical jargon.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="386" width="376" height="72" as="geometry"/></mxCell>
