        <mxCell id="node_DPF-01-03" value="&lt;b&gt;DPF-01-03  Portfolio Gate Workbench [◆] [UI / HITL]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Presents the 2x2 Quick Win vs Strategic Bet matrix for human funding sign-off.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="474" width="376" height="72" as="geometry"/></mxCell>
