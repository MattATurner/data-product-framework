        <mxCell id="node_DPF-05-03" value="&lt;b&gt;DPF-05-03  Live Acceptance Test Runner [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Executes automated BigQuery SQL assertions and static checks bound to build_digest.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1790" y="474" width="376" height="72" as="geometry"/></mxCell>
