        <mxCell id="node_DPF-00" value="&lt;b&gt;DPF-00  Data Product Framework [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#CBD5E1&#x27;&gt;Accelerates enterprise data products from candidate use case to governed outcome in 6 human-gated steps.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1092" y="84" width="460" height="74" as="geometry"/></mxCell>
        <mxCell id="node_DPF-01" value="&lt;b&gt;DPF-01  1. Discover &amp;amp; Prioritise [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Evaluates candidate business ideas and ranks Value vs Ease before engineering starts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="210" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DPF-00" target="node_DPF-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DPF-01-01" value="&lt;b&gt;DPF-01-01  Use-Case Readiness Agent [◆] [AGENT]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Reviews candidate submissions against the 11-criterion evidence rubric before panel scoring.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="298" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DPF-01" target="node_DPF-01-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DPF-01-02" value="&lt;b&gt;DPF-01-02  11-Criterion Scoring Engine [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Calculates weighted Value (3.05) and Ease (3.33) scores across eleven portfolio criteria.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="386" width="376" height="72" as="geometry"/></mxCell>
