        <mxCell id="node_DPF-04" value="&lt;b&gt;DPF-04  4. Build (Gates G2-G3) [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Composes stage skills and compiles deterministic SQL, Terraform, Catalog, and LookML.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1338" y="210" width="398" height="72" as="geometry"/></mxCell>
