        <mxCell id="node_DPF-04-03" value="&lt;b&gt;DPF-04-03  Gate G3 Multi-Plane Compiler [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Compiles Dataform/dbt SQL, Terraform IAM, LookML, and 7 ADG-00 Catalog aspects.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="474" width="376" height="72" as="geometry"/></mxCell>
