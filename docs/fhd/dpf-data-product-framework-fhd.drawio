        <mxCell id="node_DPF-02-03" value="&lt;b&gt;DPF-02-03  Business Need Sign-Off [◆] [UI / HITL]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Captures named business owner approval on the jargon-free requirement specification.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="474" width="376" height="72" as="geometry"/></mxCell>
