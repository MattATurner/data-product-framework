        <mxCell id="node_DPF-03-02" value="&lt;b&gt;DPF-03-02  Gate G1 &amp;amp; AGF Privacy Engine [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Enforces grain parity, SCD2 surrogate joins, Looker rules, and AGF C6/C10 privacy gates.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="386" width="376" height="72" as="geometry"/></mxCell>
