// The data product cycle: six human-gated steps, machine gates G0-G4 between them,
// and an OpenSpec change that starts the next loop. Reads clockwise.
// Colours: Discover & Prioritise / Describe blue, Design / Build amber, Accept / Monitor green.
// Dendrite source for dpf-lifecycle.svg. The SVG is the Dendrite SVG export with the
// white page margin cropped off, so it sits cleanly on GitHub's light and dark themes.
theme: "gcp-pro"
renderOrder: nodes-first
direction: right
spacing: 28

const Ink = "#202124"
const SubText = "#5f6368"
const CardBorder = "#dadce0"
const White = "#ffffff"
const Blue = "#1a73e8"
const Amber = "#e37400"
const Green = "#1e8e3e"
const StepGrey = "#80868b"

Style @Root {
  fill: "#f8fafd", strokeColor: "#dadce0", strokeWidth: 1.5, borderRadius: 16,
  padding: 20, gap: 16, fontColor: "#3c4043", fontSize: 18, labelWeight: bold
}
Style @BlueStage {
  fill: "#e8f0fe", strokeColor: "#8ab4f8", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 16, fontColor: $Ink, fontSize: 15, labelWeight: bold
}
Style @AmberStage {
  fill: "#fef7e0", strokeColor: "#fde293", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 16, fontColor: $Ink, fontSize: 15, labelWeight: bold
}
Style @GreenStage {
  fill: "#e6f4ea", strokeColor: "#81c995", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 16, fontColor: $Ink, fontSize: 15, labelWeight: bold
}
Style @Step {
  width: 224, height: 70,
  fill: $White, strokeColor: $CardBorder, strokeWidth: 1, borderRadius: 8,
  fontColor: $Ink, subFontColor: $SubText,
  fontSize: 12, subFontSize: 10.5, labelWeight: bold,
  textAlign: "left", textVAlign: "middle",
  iconPosition: "left", iconSize: 22, padding: 10, shadow: true
}

Style @ProductCard {
  width: 174
  height: 62
  fill: "#ffffff"
  stroke: "#dadce0"
  strokeWidth: 1
  rx: 8
  iconPosition: "left"
  textAlign: "left"
}


Zone @Cycle {
  title: "The data product cycle — 6 human-gated steps"
  subtitle: "A breach or a new need opens an OpenSpec change, which passes the same gates again"
  style: @Root
  layout: matrix
  cols: 3
  areas: [
    "prioritise describe design",
    "monitor    accept   build"
  ]
  columnGap: 56
  rowGap: 48

  Zone @Prioritise {
    area: "prioritise", title: "1. Discover & Prioritise", subtitle: "Business portfolio"
    style: @BlueStage, layout: column, align: center
    [use_case: "TRIGGER: Use Case" | "2-page candidate need"] { style: @Step, icon: "Lightbulb" }
    [agent_qa: "AGENTS: Readiness QA" | "assess-use-case check"] { style: @Step, icon: "Sparkles" }
    [score: "HITL: Score & Choose" | "11-criterion value & ease"] { style: @Step, icon: "BarChart3" }
  }

  Zone @Describe {
    area: "describe", title: "2. Describe", subtitle: "Business owns"
    style: @BlueStage, layout: column, align: center
    [brd: "BRD or PRD (A–K)" | "plain-English rubric"] { style: @Step, icon: "FileText" }
    [agent_brd: "AGENTS: Rubric Check" | "author & validate BRD"] { style: @Step, icon: "Bot" }
    [hitl_brd: "HITL: Approve Need" | "no modelling jargon"] { style: @Step, icon: "ShieldCheck" }
  }

  Zone @Design {
    area: "design", title: "3. Design", subtitle: "Business & engineering"
    style: @AmberStage, layout: column, align: center
    [tdd: "TDD + Manifest" | "context & foundations"] { style: @Step, icon: "Layers" }
    [semantics: "AGENTS: Playback" | "plain-English semantics.md"] { style: @Step, icon: "Eye" }
    [signoff: "HITL: Sign Digest" | "locked to SHA-256"] { style: @Step, icon: "ShieldCheck" }
  }

  Zone @Build {
    area: "build", title: "4. Build", subtitle: "Compose & generate"
    style: @AmberStage, layout: column, align: center
    [compose: "Compose Skills (G2)" | "Dataform, dbt & MCP"] { style: @Step, icon: "GitMerge" }
    [generate: "Multi-Plane Generate" | "SQL, Terraform, LookML"] { style: @Step, icon: "Code" }
    [golden: "HITL: Golden Copy PR" | "deterministic G3 diff"] { style: @Step, icon: "FolderGit" }
  }

  Zone @Accept {
    area: "accept", title: "5. Accept", subtitle: "Deployed proof"
    style: @GreenStage, layout: column, align: center
    [run: "Deploy & Run Live" | "sandbox SQL & checks"] { style: @Step, icon: "BigQuery" }
    [evidence: "Build Digest Proof" | "bound to SHA-256 build"] { style: @Step, icon: "Lock" }
    [attest: "HITL: Domain Attest" | "Finance & SME sign-off"] { style: @Step, icon: "User" }
  }

  Zone @Monitor {
    area: "monitor", title: "6. Monitor", subtitle: "Observability policy"
    style: @GreenStage, layout: column, align: center
    [publish: "Published Product" | "Knowledge Catalog live"] { style: @Step, icon: "Dataplex" }
    [observe: "Working-Hours Watch" | "freshness, volume, drift"] { style: @Step, icon: "CloudMonitoring" }
    [breach: "HITL: Change Loop" | "opens OpenSpec change"] { style: @Step, icon: "ShieldAlert" }
  }
}

// Steps inside each stage (thin grey)
[use_case] -> [agent_qa] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[agent_qa] -> [score] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

[brd] -> [agent_brd] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[agent_brd] -> [hitl_brd] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

[tdd] -> [semantics] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[semantics] -> [signoff] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

[compose] -> [generate] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[generate] -> [golden] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

[run] -> [evidence] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[evidence] -> [attest] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

[publish] -> [observe] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }
[observe] -> [breach] { sourceAnchor: "bottom", targetAnchor: "top", color: $StepGrey, strokeWidth: 1.5, curve: "step" }

// Machine gates between the stages (clockwise)
[Prioritise] -> [Describe] { curve: "step",  targetAnchor: "left",  sourceAnchor: "right", 
  sourceAnchor: "right", targetAnchor: "left", color: $Blue, strokeWidth: 2.5, curve: "step"
}
[Describe] -> [Design] { curve: "step",  targetAnchor: "left",  sourceAnchor: "right", 
  sourceAnchor: "right", targetAnchor: "left", color: $Blue, strokeWidth: 2.5, curve: "step",
  sequenceBadge: "G0", badgeFill: $Blue, badgeFontColor: $White, badgeDistance: 0.5
}
[Design] -> [Build] { curve: "step",  targetAnchor: "top",  sourceAnchor: "bottom", 
  sourceAnchor: "bottom", targetAnchor: "top", color: $Amber, strokeWidth: 2.5, curve: "step",
  sequenceBadge: "G1", badgeFill: $Amber, badgeFontColor: $White, badgeDistance: 0.5
}
[Build] -> [Accept] { curve: "step",  targetAnchor: "right",  sourceAnchor: "left", 
  sourceAnchor: "left", targetAnchor: "right", color: $Amber, strokeWidth: 2.5, curve: "step",
  sequenceBadge: "G3", badgeFill: $Amber, badgeFontColor: $White, badgeDistance: 0.5
}
[Accept] -> [Monitor] { curve: "step",  targetAnchor: "right",  sourceAnchor: "left", 
  sourceAnchor: "left", targetAnchor: "right", color: $Green, strokeWidth: 2.5, curve: "step",
  sequenceBadge: "G4", badgeFill: $Green, badgeFontColor: $White, badgeDistance: 0.5
}

// The loop: a breach or a new need opens an OpenSpec change, which goes round the same gates
[Monitor] -.-> [Prioritise] { curve: "step",  targetAnchor: "bottom",  sourceAnchor: "top", 
  sourceAnchor: "top", targetAnchor: "bottom", color: $Green, strokeWidth: 2.5, dashed: true, curve: "step",
  label: "OpenSpec change", labelStyle: "pill", fontSize: 12
}

animation "One loop" {
  step 1: [Prioritise] -> [Describe] { packet: "Funded", color: "#1a73e8" }
  step 2: [Describe] -> [Design] { packet: "G0", color: "#1a73e8" }
  step 3: [Design] -> [Build] { packet: "G1", color: "#e37400" }
  step 4: [Build] -> [Accept] { packet: "G2-G3", color: "#e37400" }
  step 5: [Accept] -> [Monitor] { packet: "G4", color: "#1e8e3e" }
  step 6: [Monitor] -> [Prioritise] { packet: "Change", color: "#1e8e3e" }
}
