config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "Net sales by month, customer segment, product category and region.",
  tags: ["gold"],
  assertions: {
    uniqueKey: ["year_month", "customer_segment", "product_category", "region"]
  }
}

-- Skill: direct/model-business-view
-- Satisfies: BRD-SALES-002 R-1, R-7, R-8
-- TDD D-2 (presentation only), D-8 (exclusion enforced here, not by the consumer).

SELECT
  d.year_month,
  c.customer_segment,
  p.product_category,
  c.region,

  SUM(f.net_amount)  AS net_sales,        -- additive (R-7)
  SUM(f.quantity)    AS units_sold,
  COUNT(*)           AS order_line_count

FROM ${ref("fct_order_line")} f
JOIN ${ref("dim_date")}     d ON d.date_key    = f.date_key
JOIN ${ref("dim_customer")} c ON c.sk_customer = f.sk_customer
JOIN ${ref("dim_product")}  p ON p.sk_product  = f.sk_product

WHERE NOT f.is_cancelled                  -- R-8: enforced centrally

GROUP BY 1, 2, 3, 4
