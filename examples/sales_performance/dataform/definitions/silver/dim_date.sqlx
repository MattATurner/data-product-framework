config {
  type: "table",
  schema: dataform.projectConfig.vars.slv_dataset,
  description: "Generated calendar dimension. Not sourced, so absent from the manifest.",
  tags: ["silver", "dimension"]
}

-- Skill: kimball (generated utility dimension)

SELECT
  CAST(FORMAT_DATE('%Y%m%d', d) AS INT64) AS date_key,
  d                                        AS calendar_date,
  EXTRACT(YEAR    FROM d)                  AS calendar_year,
  EXTRACT(QUARTER FROM d)                  AS calendar_quarter,
  EXTRACT(MONTH   FROM d)                  AS calendar_month,
  FORMAT_DATE('%Y-%m', d)                  AS year_month,
  FORMAT_DATE('%A',    d)                  AS day_name,
  EXTRACT(DAYOFWEEK FROM d) IN (1, 7)      AS is_weekend
FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2020-01-01', DATE '2030-12-31')) AS d
