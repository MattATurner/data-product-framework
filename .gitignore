__pycache__/
*.pyc
.venv/
generated/**
*.sqlite
*.sqlite-wal
*.sqlite-shm
.DS_Store
*.log
examples/*/seed/out/

# Terraform working state (bootstrap and example wrappers are applied from a checkout)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
tf-output.json
# Provider locks: a lock made from a local plugin directory holds one platform's hash and
# breaks `terraform init` elsewhere. Commit one only after `terraform providers lock`.
.terraform.lock.hcl
# Tool caches created when compiling generated or golden projects
node_modules/
.ci-profiles/
.df-credentials.json
.pytest_cache/
*.egg-info/
